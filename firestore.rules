rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Make sure all data operations require an authenticated user
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Example: if you have a users collection where users can only access their own data
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
  }
}
